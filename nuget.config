<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org and nothing else. The SDK, the Fallout build components and the tools are all
  published there now, so this repository restores for anyone who clones it - which is the
  entire point of it being a sample.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
